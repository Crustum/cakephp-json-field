{
    "name": "crustum/cakephp-json-field",
    "description": "JsonField plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crustum",
        "json-field"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "5.next-cake6-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^12.5 | ^13.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\JsonField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\JsonField\\Test\\": "tests/",
            "JfApp\\": "tests/TestApp/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests",
            "Company\\TestPluginThree\\Test\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/Company/TestPluginThree/tests",
            "TestApp\\": "vendor/cakephp/cakephp/tests/test_app/TestApp",
            "TestPlugin\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPlugin/src",
            "TestPlugin\\Test\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPlugin/tests",
            "TestPluginTwo\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPluginTwo/src",
            "PluginJs\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/PluginJs/src"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "extra": {
        "installer-name": "JsonField"
    },
    "config": {
        "preferred-install": {
            "cakephp/cakephp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
